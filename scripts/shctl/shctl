#!/usr/bin/env bash
# shctl - mechanika procesu SH (docs/shctl.md). Punkt wejścia: wybiera podkomendę z cmd/.
# Działa na bash 3.2 (macOS). Kody wyjścia: 0 ok, 1 błąd wykonania, 2 błędne użycie,
# 3 brak projektu, pliku lub narzędzia, 4 odmowa według reguł procesu.
set -euo pipefail

zrodlo="${BASH_SOURCE[0]}"
while [ -L "$zrodlo" ]; do
  kat="$(cd -P "$(dirname "$zrodlo")" && pwd)"
  zrodlo="$(readlink "$zrodlo")"
  case "$zrodlo" in /*) ;; *) zrodlo="$kat/$zrodlo" ;; esac
done
SHCTL_DIR="$(cd -P "$(dirname "$zrodlo")" && pwd)"

# shellcheck source=lib/common.sh
. "$SHCTL_DIR/lib/common.sh"
# shellcheck source=lib/projekt.sh
. "$SHCTL_DIR/lib/projekt.sh"

# Pomoc: pomoc/shctl.txt (przegląd) i pomoc/KOMENDA.txt (shctl KOMENDA --help). Z tych plików
# scripts/docs/shctl-md.sh generuje docs/shctl.md, a CI sprawdza zgodność.
pomoc() {
  cat "$SHCTL_DIR/pomoc/${1:-shctl}.txt" 2>/dev/null ||
    { echo "BŁĄD: brak pliku pomocy pomoc/${1:-shctl}.txt" >&2; exit "$E_BRAK"; }
}

[ $# -gt 0 ] || { pomoc >&2; exit "$E_UZYCIE"; }
KOMENDA="$1"
shift

case "$KOMENDA" in
  -h | --help | help) pomoc; exit 0 ;;
  new-project | stage | decision | escalate | status | stop-all | obsidian | doctor) ;;
  task | review | reset-dryrun | skrzynka | pr | template | sprzataj | repo | metryki | adopt | db | cykl) ;;
  *) echo "BŁĄD: nieznana komenda: $KOMENDA (shctl --help)" >&2; exit "$E_UZYCIE" ;;
esac

# --help w dowolnym miejscu po komendzie: opis komendy, bez wykonania i bez wpisu w logu.
for a in "$@"; do
  case "$a" in -h | --help) pomoc "$KOMENDA"; exit 0 ;; esac
done

start_shctl "$KOMENDA" "$@"
# shellcheck disable=SC1090
. "$SHCTL_DIR/cmd/$KOMENDA.sh"
komenda_main "$@"
