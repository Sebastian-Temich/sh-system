#!/usr/bin/env bash
# shctl - mechanika procesu SH (docs/shctl.md). Punkt wejścia: wybiera podkomendę z cmd/.
# Działa na bash 3.2 (macOS). Kody wyjścia: 0 ok, 1 błąd wykonania, 2 błędne użycie,
# 3 brak projektu, pliku lub narzędzia, 4 odmowa według reguł procesu.
set -euo pipefail

zrodlo="${BASH_SOURCE[0]}"
while [ -L "$zrodlo" ]; do
  kat="$(cd -P "$(dirname "$zrodlo")" && pwd)"
  zrodlo="$(readlink "$zrodlo")"
  case "$zrodlo" in /*) ;; *) zrodlo="$kat/$zrodlo" ;; esac
done
SHCTL_DIR="$(cd -P "$(dirname "$zrodlo")" && pwd)"

# shellcheck source=lib/common.sh
. "$SHCTL_DIR/lib/common.sh"
# shellcheck source=lib/projekt.sh
. "$SHCTL_DIR/lib/projekt.sh"

pomoc() {
  cat <<'TXT'
Użycie: shctl KOMENDA [argumenty] [--dry-run] [--json] [--projekt NAZWA]

  new-project NAZWA --opis "krótki opis repo" [--zlecenie "..."] [--tryb S|M] [--prywatny]
  repo opis [--opis "..."] [--topics "a,b"] [--website URL]
  stage start|review|done|escalate ETAP [--notatka "..."]
  stage iter ETAP
  decision add --co "..." --dlaczego "..." --cofniecie "..." [--rola ROLA]
  escalate --dotyczy "#NR|ETAP" --powod "..." --potrzebne "..." [--opcje "A;B"] [--priorytet high] [--akceptacja] [--typ blokada|pytanie]
  escalate close E-NNN --odpowiedz "..."
  status show
  stop-all
  skrzynka przyjmij NAZWA
  obsidian link|unlink NAZWA
  doctor [--test-notify]
  task create --plik zadania.yaml
  task ready [--czekaj] [--timeout SEKUNDY]
  task dispatch NR
  task iter NR
  task close NR [--odbior] [--anuluj [--powod "..."]]   (task cancel NR: alias do następnej wersji)
  task resume-check NR [--testy "..."] [--bez-testow]
  task wait NR [--timeout SEKUNDY]
  pr check PR [--czekaj] [--timeout SEKUNDY]
  review run PR [--timeout SEKUNDY]
  reset-dryrun
  template update [--baseline] [--force]
  sprzataj

Dokumentacja: sh-system/docs/shctl.md
TXT
}

[ $# -gt 0 ] || { pomoc >&2; exit "$E_UZYCIE"; }
KOMENDA="$1"
shift

case "$KOMENDA" in
  -h | --help | help) pomoc; exit 0 ;;
  new-project | stage | decision | escalate | status | stop-all | obsidian | doctor) ;;
  task | review | reset-dryrun | skrzynka | pr | template | sprzataj | repo) ;;
  *) echo "BŁĄD: nieznana komenda: $KOMENDA (shctl --help)" >&2; exit "$E_UZYCIE" ;;
esac

start_shctl "$KOMENDA" "$@"
# shellcheck disable=SC1090
. "$SHCTL_DIR/cmd/$KOMENDA.sh"
komenda_main "$@"
