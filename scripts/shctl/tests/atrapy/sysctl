#!/usr/bin/env bash
# Atrapa sysctl -n: vm.loadavg z $SYSCTL_LOAD (np. "1.50 2.00 2.50"), vm.swapusage, hw.ncpu. $SYSCTL_BLAD: błąd.
# Jak prawdziwy sysctl: przy polskim locale (LC_ALL, LC_NUMERIC albo LANG pl_*) przecinek dziesiętny.
[ -z "${SYSCTL_BLAD:-}" ] || { echo "sysctl: Operation not permitted" >&2; exit 1; }
[ "${1:-}" = -n ] && shift
loc="${LC_ALL:-${LC_NUMERIC:-${LANG:-}}}"
liczby() { case "$loc" in pl_*) tr . , ;; *) cat ;; esac; }
case "${1:-}" in
  vm.loadavg) echo "{ ${SYSCTL_LOAD:-1.50 2.00 2.50} }" | liczby ;;
  vm.swapusage) echo "total = 4096.00M  used = ${SYSCTL_SWAP:-3277.25M}  free = 818.75M  (encrypted)" | liczby ;;
  hw.ncpu) echo 4 ;;
  *) echo "sysctl: unknown oid '$1'" >&2; exit 1 ;;
esac
