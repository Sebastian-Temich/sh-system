<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pl.iskt.softwarehouse.obsidian-sync</string>
  <!-- Synchronizacja klonów docs/ w vaulcie Obsidiana: git pull --ff-only co 5 minut (docs/serwer.md). -->
  <!-- Wyłączenie: /Users/Shared/sh/stan/obsidian-sync.off (przebieg się pomija, install.sh nie ładuje agenta). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/Shared/sh/bin/obsidian-sync.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/sebastiant./.local/bin:/Users/Shared/sh/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>pl_PL.UTF-8</string>
    <!-- Katalog SH wprost, nie przez dowiązanie ~/sh (docs/serwer.md, „Katalog SH”). -->
    <key>SH_DIR</key>
    <string>/Users/Shared/sh</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/Shared/sh</string>
  <!-- Skrypt sam pisze do obsidian-sync.log; tu trafiają tylko nieprzechwycone błędy. -->
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/Users/Shared/sh/logs/obsidian-sync.log</string>
</dict>
</plist>
