# /Users/Shared/sh/Brewfile - narzedzia zarzadzane przez Homebrew na serwerze (iMac13,2, Intel, macOS 14).
#
# UWAGA: przy `git --version` < 2.30 KAZDE polecenie `brew` probuje zbudowac gita ze zrodel.
# Dzis jest 2.39.5 z CLT 16.2, wiec brew dziala.
# Stosuj: brew bundle check --file /Users/Shared/sh/Brewfile --no-upgrade
#
# Zasada: na Intel + Sonoma Homebrew nie buduje juz wiekszosci butelek. Formula bez butelki
# (`sonoma` albo `all`) kompiluje sie lokalnie, wiec tu trafiaja tylko te z butelka.
# Sprawdzenie: curl -fsS https://formulae.brew.sh/api/formula/NAZWA.json | jq '.bottle.stable.files|keys'

brew "jq"

# Maja butelke, ale sa z oficjalnych binarek w ~/.local/bin (setup-toolchain.sh).
# Mozna je przeniesc tutaj; brew zainstaluje je obok istniejacych binarek:
# brew "gitleaks"   # butelka: sonoma
# brew "fnm"        # butelka: sonoma
# brew "bats-core"  # butelka: all

# Celowo poza Homebrew (brak butelki Intel Sonoma, budowa ze zrodel: rust/go/pandoc):
# git  -> z Command Line Tools
# uv   -> oficjalna binarka, setup-toolchain.sh
# yq   -> oficjalna binarka, setup-toolchain.sh
# gh   -> juz zainstalowany w ~/.local/bin

# Dopisane przez agentow (format: brew "nazwa"  # data, projekt, po co):
